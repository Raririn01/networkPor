# Track only the project submission, never the entire Local/WordPress installation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README-INF-NEXT.md
!/setup-inf-next.php
!/setup-alien-cs.php
!/alien-buu-cs-preview.jpg
!/app/
/app/*
!/app/public/
/app/public/*
!/app/public/wp-content/
/app/public/wp-content/*
!/app/public/wp-content/themes/
/app/public/wp-content/themes/*
!/app/public/wp-content/themes/inf-next/
!/app/public/wp-content/uploads/
/app/public/wp-content/uploads/*
!/app/public/wp-content/uploads/alien-buu/
/app/public/wp-content/uploads/alien-buu/*
!/app/public/wp-content/uploads/alien-buu/cs-source-*.png
!/app/public/wp-content/uploads/2026/
/app/public/wp-content/uploads/2026/*
!/app/public/wp-content/uploads/2026/10/
/app/public/wp-content/uploads/2026/10/*
!/app/public/wp-content/uploads/2026/10/chaisiri-sanitphonklang.png
!/app/public/wp-content/uploads/2026/10/janya-onpans.png
!/app/public/wp-content/uploads/2026/10/worawit-werapan.png

# Defense in depth for files accidentally placed inside the theme.
**/.env
**/.env.*
**/wp-config.php
**/*.sql
**/*.sql.gz
**/*.wpress
**/*.zip
**/*.7z
**/*.pem
**/*.key
**/*.log
**/node_modules/
**/.DS_Store
**/Thumbs.db
